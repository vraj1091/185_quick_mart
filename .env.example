# Copy this file to .env and fill it in. Never commit .env.

# Database.
#   Local development (SQLite file, created by `npm run setup`):
DATABASE_URL="file:./dev.db"
#   Production (PostgreSQL from Neon, Supabase, or Vercel Postgres), for example:
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Owner login for /admin. Generate with:  npm run admin:password -- "your-password"
# In a .env file every "$" in the hash must be written as "\$" (the script prints it that way).
# On Vercel, paste the plain hash (no backslashes).
ADMIN_PASSWORD_HASH=""

# Random string, at least 32 characters. Signs the admin login cookie.
# Generate with:  node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
SESSION_SECRET=""

# Contact form email (optional; messages are always saved to the admin inbox).
# Get a key at https://resend.com and verify your sending domain there.
RESEND_API_KEY=""
CONTACT_TO_EMAIL=""
# Sender address on your verified Resend domain, e.g. "185 Quick Mart website <website@yourdomain.com>"
CONTACT_FROM_EMAIL=""

# Public address of the site, no trailing slash. Used for canonical URLs, sitemap and share images.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
